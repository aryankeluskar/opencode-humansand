{
  "name": "opencode-humansand",
  "version": "0.1.0",
  "description": "humans& Ampersand (ampersand-v0.1) for OpenCode and the AI SDK: server-held Agents-API sessions bridged to stateless model calls.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryankeluskar/opencode-humansand.git"
  },
  "homepage": "https://github.com/aryankeluskar/opencode-humansand#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-sdk",
    "ai-sdk-provider",
    "humansand",
    "ampersand",
    "agents-api",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.19",
    "@ai-sdk/provider-utils": "^4.0.62"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
